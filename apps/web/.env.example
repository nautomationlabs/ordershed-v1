# mock   = in-browser sandbox data (default)
# http   = every screen calls the backend at VITE_API_BASE_URL
# hybrid = only the features in VITE_API_LIVE call the backend; the rest stay on sandbox data
VITE_API_MODE=mock
VITE_API_BASE_URL=/v1
VITE_API_LIVE=join,verification,audit,auth
VITE_ENV_LABEL=SANDBOX
VITE_APP_VERSION=0.1.0
