# Backend (services/api). Copy to .env in the repo root; .env is never committed.
# Development works with none of these set: local Docker database, console WhatsApp/email, GST stand-in.

# Database (docker-compose.yml). In AWS these come from Secrets Manager.
# DATABASE_URL=postgres://ordershed_app:app_dev_only@localhost:5433/ordershed
# DATABASE_OWNER_URL=postgres://ordershed_owner:owner_dev_only@localhost:5433/ordershed
# APP_DB_PASSWORD=app_dev_only
# OTP_PEPPER=<random 32+ characters in production>

# WhatsApp Cloud API. console = log codes instead of sending; cloud = send through Meta.
WHATSAPP_MODE=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1400589979812865
WHATSAPP_WABA_ID=1122088907237542
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_OTP_TEMPLATE=ordershed_code

# GSTIN lookup. stub = fictional records; cashfree = Cashfree Verification Suite.
GST_PROVIDER=stub
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Path to the public key downloaded from Cashfree (avoids IP allow-listing), e.g. secrets/cashfree_public_key.pem
CASHFREE_PUBLIC_KEY_PATH=

# Metering
RFQ_COST_ALERT_INR=150
GST_LOOKUP_COST_INR=0
WHATSAPP_CODE_COST_INR=0
